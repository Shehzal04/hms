# HostelFlow - Environment Configuration

# Flask App Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Default: SQLite (ready out of the box)
DATABASE_URL=sqlite:///hms.db

# To use MySQL (Enterprise Primary):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hostel_db?charset=utf8mb4

# Server settings
PORT=5000
HOST=127.0.0.1
